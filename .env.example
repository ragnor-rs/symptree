# symptree — local development environment.
#
#   cp .env.example .env
#
# `docker compose` reads `.env` automatically. To run a module straight from a
# fat jar instead, export the same values into your shell first:
#
#   set -a; source .env; set +a
#
# Every value below is a DEV-ONLY PLACEHOLDER. Nothing here is a real secret and
# nothing here is safe to deploy. Production reads the same variable names from a
# secret manager (see specs/technical-spec.md § 6).
#
# docker-compose.yml deliberately declares no ${VAR:-default} fallbacks, so a
# variable missing from this file surfaces as an empty value and the fail-fast
# guards in CoreConfig/MessagingConfig reject it loudly at startup.

# --- Postgres -----------------------------------------------------------------
# Consumed by the `postgres` service AND by core's JDBC connection. The postgres
# image refuses to initialize with an empty POSTGRES_PASSWORD, so this must be
# set before the very first `docker compose up -d postgres`.
POSTGRES_DB=symptree
POSTGRES_USER=symptree_user
POSTGRES_PASSWORD=dev

# --- Platform admin -----------------------------------------------------------
# Authenticates POST /api/v1/clinics (the clinic-onboarding endpoint) via the
# X-API-Key header. Without it core refuses to start.
PLATFORM_ADMIN_API_KEY=dev-platform-key

# --- Bot <-> core shared secrets ----------------------------------------------
# Two DISTINCT secrets, each of which must match between core and messaging:
#   ingress  — gates POST /api/v1/clinics/{slug}/bot/ingress (bot -> core)
#   internal — gates POST /bot-internal/outgoing (core's reminder scheduler -> bot)
BOT_INGRESS_SHARED_SECRET=dev-ingress
BOT_INTERNAL_SHARED_SECRET=dev-internal

# --- OpenAI -------------------------------------------------------------------
# Used by the symptomizer's LLM router: picking which tree a complaint belongs
# to, intent classification, and free-text -> option mapping. Core requires a
# NON-BLANK value to start but never validates it, so the placeholder below is
# enough to boot the stack, serve the admin panel and answer /start.
#
# It is NOT enough to walk a tree: choosing the tree for a complaint has no
# button-only fallback, so the first symptom message fails with 500. Replace
# this with a real key for any end-to-end triage run. (The documented
# button-only degradation covers only the mid-tree option-mapping step.)
OPENAI_API_KEY=sk-placeholder-button-only-mode
OPENAI_MODEL=gpt-4o-2024-08-06

# --- PII encryption key (AES-256-GCM) -----------------------------------------
# Encrypts the patient free text stored in sessions.history. Must decode to
# exactly 32 bytes — either 32 raw characters (as below) or a Base64-encoded
# 32-byte key. Regenerate with: openssl rand -base64 32
SYMPTREE_PII_KEY=0123456789abcdef0123456789abcdef

# --- Admin-panel bearer tokens ------------------------------------------------
# HMAC-SHA256 signing secret for clinic-admin logins, and the token TTL in
# minutes (480 = 8h). Regenerate with: openssl rand -base64 32
ADMIN_TOKEN_SECRET=dev-admin-token-secret-change-me
ADMIN_TOKEN_TTL_MINUTES=480

# --- Telegram bot (optional) --------------------------------------------------
# Only needed to run the `messaging` module. CLINIC_SLUG must match a clinic you
# created via POST /api/v1/clinics. Get a token from https://t.me/botfather —
# treat it as a real secret: anyone holding it can impersonate your bot.
# One bot process serves one clinic.
TELEGRAM_BOT_TOKEN=
CLINIC_SLUG=demo-clinic
