# symptree — staging deploy secrets TEMPLATE.
#
#   cp scripts/secrets.staging.env.example scripts/secrets.staging.env
#   # then fill in the real values below
#
# scripts/secrets.staging.env is GITIGNORED — never commit it. deploy.sh sources it
# (for --env staging) and writes the resolved values into the remote /opt/symptree/.env,
# which is the single source of truth docker-compose.yml reads.
#
# Generate fresh random secrets for staging (do NOT reuse dev/.env.local values):
#   openssl rand -base64 32                      # shared secrets, admin token, pg password
#   openssl rand -base64 32                      # SYMPTREE_PII_KEY: must decode to exactly 32 bytes
#                                                #   (base64 of 32 raw bytes satisfies this)

# --- Postgres ----------------------------------------------------------------
POSTGRES_PASSWORD=change-me

# --- core (backend) ----------------------------------------------------------
# Mints/manages clinics via POST /api/v1/clinics (X-API-Key).
PLATFORM_ADMIN_API_KEY=change-me
# Gates bot → backend ingress. MUST match between core and messaging.
BOT_INGRESS_SHARED_SECRET=change-me
# Gates core reminder-scheduler → messaging /bot-internal/outgoing. MUST match
# between core and messaging. Distinct from the ingress secret.
BOT_INTERNAL_SHARED_SECRET=change-me
# OpenAI key for the symptomizer LLM router (PWVTT4).
OPENAI_API_KEY=sk-...
# AES-256-GCM key for PII encryption — must decode to exactly 32 bytes
# (32 raw UTF-8 chars, or base64 of 32 bytes).
SYMPTREE_PII_KEY=change-me-32-bytes-................
# HMAC-SHA256 signing secret for admin-panel bearer tokens.
ADMIN_TOKEN_SECRET=change-me

# --- messaging (Telegram bot) ------------------------------------------------
# A SEPARATE staging BotFather bot token (not the dev-clinic token from .env.local,
# so staging and local don't fight over the same bot's long-poll).
TELEGRAM_BOT_TOKEN=123456:ABC...
# The clinic slug this staging bot serves. NOTE the two-step below.
CLINIC_SLUG=staging-clinic

# --- Optional overrides (defaults shown; usually leave unset) -----------------
# POSTGRES_DB=symptree
# POSTGRES_USER=symptree_user
# OPENAI_MODEL=gpt-4o-2024-08-06

# ─────────────────────────────────────────────────────────────────────────────
# TWO-STEP first deploy (the bot needs a clinic that exists in the DB):
#   1. Deploy core first so the API is up:
#        ./scripts/deploy.sh --env staging --postgres --core --admin-panel
#   2. Create the staging clinic (returns its admin key once):
#        curl -X POST http://<staging-ip>:8080/api/v1/clinics \
#          -H "X-API-Key: $PLATFORM_ADMIN_API_KEY" -H 'Content-Type: application/json' \
#          -d '{"slug":"staging-clinic","name":"Staging Clinic",
#               "default_language":"ru","allowed_languages":["ru","kk"]}'
#   3. Set CLINIC_SLUG above to that slug, then bring up the bot:
#        ./scripts/deploy.sh --env staging --messaging
# ─────────────────────────────────────────────────────────────────────────────
